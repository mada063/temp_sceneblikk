{
  "name": "sceneblikk-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:webapp": "npm run dev --workspace=apps/webapp",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "npm run dev:webapp",
    "build:webapp": "npm run build --workspace=apps/webapp",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:webapp && npm run build:web",
    "lint:webapp": "npm run lint --workspace=apps/webapp",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint": "npm run lint:webapp && npm run lint:web",
    "install:all": "npm install"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
